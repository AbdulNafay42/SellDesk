generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  INTERACTIVE
  LOCATION
  BUTTON
  TEMPLATE
  OTHER
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SENT
  DELIVERED
  READ
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  platformRole  PlatformRole     @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  memberships   BusinessMember[]
  invitations   InvitationToken[]
}

model Business {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  status          BusinessStatus   @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  currency        String           @default("PKR")
  phone           String?
  city            String?
  country         String           @default("Pakistan")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members         BusinessMember[]
  invitations     InvitationToken[]
  categories      Category[]
  products        Product[]
  variants        ProductVariant[]
  customers       Customer[]
  orders          Order[]
  whatsAppConfig  WhatsAppConfig?
  conversations   Conversation[]
  messages        Message[]
  stockMovements  StockMovement[]
  payments        PaymentRecord[]
  consignments    Consignment[]
  returns         ReturnRequest[]
  followups       FollowupLead[]
  aiActions       AiAction[]
  invoices        Invoice[]
}

model WhatsAppConfig {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  phoneNumberId      String   @unique
  wabaId             String?
  accessToken        String
  verifyToken        String?
  displayPhoneNumber String?
  verifiedName       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
}

model InvitationToken {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  userId      String?
  businessId  String
  role        Role      @default(OWNER)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id          String   @id @default(uuid())
  userId      String
  businessId  String
  role        Role     @default(STAFF)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Category {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  slug        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, slug])
  @@index([businessId])
}

model Product {
  id          String           @id @default(uuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  basePrice   Float
  sku         String?
  status      ProductStatus    @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([businessId])
}

model ProductVariant {
  id         String   @id @default(uuid())
  businessId String
  productId  String
  size       String?  // S, M, L, XL, XXL, Custom
  color      String?  // Black, White, Red, etc.
  sku        String
  price      Float
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([productId])
}

model Customer {
  id          String   @id @default(uuid())
  businessId  String
  fullName    String
  phoneNumber String
  city        String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@index([businessId, phoneNumber])
}

model Order {
  id            String        @id @default(uuid())
  businessId    String
  customerId    String
  orderNumber   String
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String        @default("COD") // COD, BankTransfer, EasyPaisa, JazzCash
  subtotal      Float
  shippingFee   Float         @default(0)
  totalAmount   Float
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id])

  @@unique([businessId, orderNumber])
  @@index([businessId])
}

model Conversation {
  id                  String              @id @default(uuid())
  businessId          String
  customerId          String
  channel             ConversationChannel @default(WHATSAPP)
  externalContactId   String
  status              ConversationStatus  @default(OPEN)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@unique([businessId, channel, externalContactId])
  @@index([businessId])
  @@index([customerId])
}

model Message {
  id                  String           @id @default(uuid())
  businessId          String
  conversationId      String
  externalMessageId   String?
  direction           MessageDirection
  type                MessageType      @default(TEXT)
  text                String?
  status              MessageStatus    @default(RECEIVED)
  externalTimestamp   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([businessId, externalMessageId])
  @@index([businessId])
  @@index([conversationId])
}

model StockMovement {
  id            String   @id @default(uuid())
  businessId    String
  sku           String
  productName   String
  variantInfo   String?
  type          String   // INBOUND_RESTOCK, OUTBOUND_ORDER, RETURN_RESTOCK, ADJUSTMENT
  quantity      Int
  previousStock Int      @default(0)
  newStock      Int      @default(0)
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model PaymentRecord {
  id            String   @id @default(uuid())
  businessId    String
  orderNumber   String
  customerName  String
  customerPhone String
  paymentMethod String   // COD, BANK_TRANSFER, JAZZCASH, EASYPAISA, RAAST
  amountPKR     Float
  status        String   @default("PENDING_VERIFICATION") // PAID, PENDING_VERIFICATION, REFUNDED
  trxId         String?
  date          String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Consignment {
  id              String   @id @default(uuid())
  businessId      String
  cnNumber        String
  courier         String   // TRAX, LEOPARD, CALLCOURIER, TCS
  orderNumber     String
  customerName    String
  customerPhone   String
  destinationCity String
  address         String
  codAmountPKR    Float
  weightKg        Float    @default(0.5)
  pieces          Int      @default(1)
  status          String   @default("BOOKED") // BOOKED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED_TO_ORIGIN
  bookingDate     String?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, cnNumber])
  @@index([businessId])
}

model ReturnRequest {
  id            String   @id @default(uuid())
  businessId    String
  returnNumber  String
  orderNumber   String
  customerName  String
  customerPhone String
  productName   String
  sku           String
  quantity      Int      @default(1)
  returnReason  String   // SIZE_MISMATCH, WRONG_ITEM_SENT, DEFECTIVE, COD_REFUSED
  status        String   @default("RETURN_REQUESTED") // RETURN_REQUESTED, APPROVED, RECEIVED_IN_WAREHOUSE, RESTOCKED, REFUNDED
  requestDate   String?
  restocked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, returnNumber])
  @@index([businessId])
}

model FollowupLead {
  id                String   @id @default(uuid())
  businessId        String
  customerName      String
  customerPhone     String
  city              String?
  inquiredProduct   String
  hoursElapsed      Int      @default(0)
  lastMessage       String?
  suggestedFollowup String?
  status            String   @default("PENDING") // PENDING, SENT, CONVERTED, DISMISSED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AiAction {
  id            String   @id @default(uuid())
  businessId    String
  type          String   // ORDER_EXTRACTION, CUSTOMIZATION_REQUEST, etc.
  customerName  String
  customerPhone String
  rawText       String
  extractedData String?  // JSON stringified payload
  confidence    Float    @default(0.95)
  status        String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Invoice {
  id            String   @id @default(uuid())
  businessId    String
  invoiceNumber String
  amountPKR     Float
  date          String
  status        String   @default("PAID") // PAID, PENDING, UNPAID
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
}

