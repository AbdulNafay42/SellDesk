generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  OTHER
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SENT
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  platformRole  PlatformRole     @default(USER)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  memberships   BusinessMember[]
  invitations   InvitationToken[]
}

model Business {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  status          BusinessStatus   @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  currency        String           @default("PKR")
  phone           String?
  city            String?
  country         String           @default("Pakistan")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members         BusinessMember[]
  invitations     InvitationToken[]
  products        Product[]
  customers       Customer[]
  orders          Order[]
  whatsAppConfig  WhatsAppConfig?
  conversations   Conversation[]
  messages        Message[]
}

model WhatsAppConfig {
  id                 String   @id @default(uuid())
  businessId         String   @unique
  phoneNumberId      String   @unique
  wabaId             String?
  accessToken        String
  verifyToken        String?
  displayPhoneNumber String?
  verifiedName       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
}

model InvitationToken {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  userId      String?
  businessId  String
  role        Role      @default(OWNER)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessMember {
  id          String   @id @default(uuid())
  userId      String
  businessId  String
  role        Role     @default(STAFF)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String
  products    Product[]
}

model Product {
  id          String           @id @default(uuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  basePrice   Float
  sku         String?
  status      ProductStatus    @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([businessId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  size      String?  // S, M, L, XL, XXL, Custom
  color     String?  // Black, White, Red, etc.
  sku       String   @unique
  price     Float
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id          String   @id @default(uuid())
  businessId  String
  fullName    String
  phoneNumber String
  city        String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@index([businessId, phoneNumber])
}

model Order {
  id            String        @id @default(uuid())
  businessId    String
  customerId    String
  orderNumber   String        @unique
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String        @default("COD") // COD, BankTransfer, EasyPaisa, JazzCash
  subtotal      Float
  shippingFee   Float         @default(0)
  totalAmount   Float
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id])

  @@index([businessId])
}

model Conversation {
  id                  String              @id @default(uuid())
  businessId          String
  customerId          String
  channel             ConversationChannel @default(WHATSAPP)
  externalContactId   String
  status              ConversationStatus  @default(OPEN)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@unique([businessId, channel, externalContactId])
  @@index([businessId])
  @@index([customerId])
}

model Message {
  id                  String           @id @default(uuid())
  businessId          String
  conversationId      String
  externalMessageId   String?
  direction           MessageDirection
  type                MessageType      @default(TEXT)
  text                String?
  status              MessageStatus    @default(RECEIVED)
  externalTimestamp   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  business            Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([businessId, externalMessageId])
  @@index([businessId])
  @@index([conversationId])
}
